{
  "_fonte": "spec/01-combate.md + spec/45-controlos-configuraveis.md + spec/73-fecho-dos-buracos-de-integracao.md.",
  "_nota": "O mapa e construido em runtime pelo GameData a partir deste ficheiro - remapear nao exige recompilar. Teclado+rato continua primario porque nenhuma das duas maquinas tem comando; o esquema de comando e um default completo e sintetico a provar em hardware no M2.",
  "_nota_cast": "[DECIDIDO] (Mateus, 01-08): com instrumento na secundaria, attack conjura o feitico activo; sem mana faz a pancada da arma principal; heavy_mod/duas maos mantem a pancada como alternativa. F/roda percorre os oito favoritos. [CODEX] cast conserva C/X como alternativa remapeavel ate o dono da UI retirar a instrucao antiga; razao: nao deixar a ajuda actual mentir nesta arvore; alternativa descartada: desligar C/X antes de actualizar GameShell e SpellHud.",
  "_nota_mapa": "[PROTO] G abre o mapa porque M ja pertence a meditar. E apenas o default: a interface le sempre a ligacao corrente de open_map.",
  "_nota_levantar": "[CODEX] Levantar tem uma accao propria e remapeavel. B e apenas o valor de fabrica; jogador, opcoes, instrucoes e teste consultam sempre raise_dead.",

  "gamepad_required": [
    "move_forward", "move_back", "move_left", "move_right", "attack", "heavy_mod",
    "block", "parry", "dodge_sprint", "lock_on", "next_spell", "cast", "meditate",
    "use_item", "ability", "toggle_grip", "interact", "open_map", "loadout_next", "loadout_prev",
    "look_left", "look_right", "look_up", "look_down"
  ],

  "actions": {
    "move_forward":   [{ "type": "key", "key": "W" }, { "type": "joypad_motion", "axis": 1, "value": -1.0, "label": "stick esquerdo cima" }],
    "move_back":      [{ "type": "key", "key": "S" }, { "type": "joypad_motion", "axis": 1, "value": 1.0, "label": "stick esquerdo baixo" }],
    "move_left":      [{ "type": "key", "key": "A" }, { "type": "joypad_motion", "axis": 0, "value": -1.0, "label": "stick esquerdo esquerda" }],
    "move_right":     [{ "type": "key", "key": "D" }, { "type": "joypad_motion", "axis": 0, "value": 1.0, "label": "stick esquerdo direita" }],

    "look_left":      [{ "type": "key", "key": "ArrowLeft" }, { "type": "joypad_motion", "axis": 2, "value": -1.0, "label": "stick direito esquerda" }],
    "look_right":     [{ "type": "key", "key": "ArrowRight" }, { "type": "joypad_motion", "axis": 2, "value": 1.0, "label": "stick direito direita" }],
    "look_up":        [{ "type": "key", "key": "ArrowUp" }, { "type": "joypad_motion", "axis": 3, "value": -1.0, "label": "stick direito cima" }],
    "look_down":      [{ "type": "key", "key": "ArrowDown" }, { "type": "joypad_motion", "axis": 3, "value": 1.0, "label": "stick direito baixo" }],

    "attack":         [{ "type": "mouse", "button": 1 }, { "type": "joypad_button", "button": 10, "label": "RB/R1" }],
    "heavy_mod":      [{ "type": "key", "key": "Shift" }, { "type": "joypad_motion", "axis": 5, "value": 1.0, "label": "RT/R2" }],
    "block":          [{ "type": "mouse", "button": 2 }, { "type": "joypad_motion", "axis": 4, "value": 1.0, "label": "LT/L2" }],
    "parry":          [{ "type": "key", "key": "Q" }, { "type": "joypad_button", "button": 9, "label": "LB/L1" }],
    "dodge_sprint":   [{ "type": "key", "key": "Space" }, { "type": "joypad_button", "button": 0, "label": "A/cruz" }],
    "lock_on":        [{ "type": "key", "key": "Tab" }, { "type": "joypad_button", "button": 8, "label": "stick direito" }],

    "next_spell":     [{ "type": "key", "key": "F" }, { "type": "joypad_button", "button": 11, "label": "d-pad cima" }],
    "cast":           [{ "type": "key", "key": "C" }, { "type": "joypad_button", "button": 2, "label": "X/quadrado" }],
    "meditate":       [{ "type": "key", "key": "M" }, { "type": "joypad_button", "button": 12, "label": "d-pad baixo" }],
    "use_item":       [{ "type": "key", "key": "R" }, { "type": "joypad_button", "button": 1, "label": "B/circulo" }],
    "ability":        [{ "type": "key", "key": "V" }, { "type": "joypad_button", "button": 6, "label": "Start/Options" }],
    "raise_dead":     [{ "type": "key", "key": "B" }],
    "toggle_grip":    [{ "type": "key", "key": "T" }, { "type": "joypad_button", "button": 3, "label": "Y/triangulo" }],
    "interact":       [{ "type": "key", "key": "E" }, { "type": "joypad_button", "button": 2, "label": "X/quadrado contextual" }],
    "inventory_menu": [{ "type": "key", "key": "I" }, { "type": "joypad_button", "button": 4, "label": "Select/View" }],
    "open_map":       [{ "type": "key", "key": "G" }, { "type": "joypad_button", "button": 7, "label": "Botao do analogico esquerdo" }],
    "debug_class_next": [{ "type": "key", "key": "F6" }],

    "hotbar_1":       [{ "type": "key", "key": "1" }],
    "hotbar_2":       [{ "type": "key", "key": "2" }],
    "hotbar_3":       [{ "type": "key", "key": "3" }],
    "hotbar_4":       [{ "type": "key", "key": "4" }],
    "hotbar_5":       [{ "type": "key", "key": "5" }],

    "loadout_next":   [{ "type": "key", "key": "BracketRight" }, { "type": "joypad_button", "button": 14, "label": "d-pad direita" }],
    "loadout_prev":   [{ "type": "key", "key": "BracketLeft" }, { "type": "joypad_button", "button": 13, "label": "d-pad esquerda" }],

    "toggle_perf":    [{ "type": "key", "key": "F1" }],
    "toggle_help":    [{ "type": "key", "key": "F2" }],
    "toggle_mouse":   [{ "type": "key", "key": "F3" }],
    "reset_arena":    [{ "type": "key", "key": "F5" }],
    "pause_menu":     [{ "type": "key", "key": "Escape" }]
  }
}
